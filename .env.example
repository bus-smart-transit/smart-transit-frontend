# Point this to your tunnel URL when the backend runs locally
# e.g. VITE_API_BASE_URL=https://your-tunnel-url.trycloudflare.com/api
VITE_API_BASE_URL=

# Traffic / ETA provider settings (free-tier friendly)
# Supported providers: fallback, mapbox, ors
# Leave fallback enabled until you have a real API key.
VITE_TRAFFIC_PROVIDER=fallback
VITE_TRAFFIC_API_BASE=
VITE_TRAFFIC_API_KEY=